<configuration>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Standard File Appender (Non-Rolling) -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <!-- Path where the log file will be saved -->
        <file>logs/javalin-app.log</file>
        <!-- Append to the existing file instead of overwriting on restart -->
        <append>true</append>
        <!-- Immediate flush ensures logs are written instantly -->
        <immediateFlush>true</immediateFlush>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Framework specific overrides for Javalin debugging -->
    <logger name="io.javalin" level="DEBUG" />
    <logger name="org.eclipse.jetty" level="DEBUG" />

    <!-- Root Logger applying both appenders -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>