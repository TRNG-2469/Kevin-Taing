<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="bbCoach" class="com.rev.sp.BaseBallCoach" scope="singleton" init-method="myInit" destroy-method="myCleanUp">
        <constructor-arg ref="hf"/>
    </bean>
    <bean id="swimCoach" class="com.rev.sp.SwimCoach"/>
    <bean id="hf" class="com.rev.sp.HappyFortune"/>
</beans>